# Development Environment (local)
# Run: cp .env.example .env and edit .env for your local setup
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=customer_management
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# Production Environment (Railway)
# These values will be set automatically by Railway when you create a MySQL database
# DB_HOST=containers-us-west-99.railway.app
# DB_PORT=3306# DB_USER=root
# DB_USER=your_railway_db_user
# DB_PASSWORD=your_railway_db_password
# DB_NAME=railway
# FLASK_ENV=production
# FLASK_DEBUG=False
# FLASK_PORT=8080
# SECRET_KEY=your-production-secret-key-at-least-32-characters
