{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "python",
      "runtimeArgs": ["run.py"],
      "port": 5000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000", "--directory", "frontend"],
      "port": 8000,
      "autoPort": false
    }
  ]
}
